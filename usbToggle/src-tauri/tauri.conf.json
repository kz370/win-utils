{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "usbToggle",
  "mainBinaryName": "usbToggle",
  "version": "1.1.0",
  "identifier": "com.usbtoggle.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "USB Toggle",
        "width": 620,
        "height": 760,
        "minWidth": 440,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "../assets/app_icon.ico"
    ],
    "shortDescription": "Turn USB devices on and off"
  }
}
