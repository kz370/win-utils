{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "usbToggle",
  "version": "1.0.0",
  "identifier": "com.usbtoggle.usbToggle",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "echo done",
    "beforeBuildCommand": "echo done"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "usbToggle",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.ico"
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
